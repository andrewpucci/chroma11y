{
  "name": "chroma11y",
  "version": "1.0.0",
  "description": "Accessible color palette generator powered by OKLCH, with WCAG contrast checking and multiple export formats",
  "keywords": [
    "color",
    "palette",
    "generator",
    "accessibility",
    "oklch",
    "a11y",
    "chroma11y",
    "design-tokens",
    "wcag",
    "contrast"
  ],
  "license": "GPL-3.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "generate:favicons": "node scripts/generate-favicons.js",
    "prepare": "svelte-kit sync || true && husky",
    "hooks:install": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && oxlint && eslint .",
    "lint:fix": "prettier --write . && oxlint --fix && eslint . --fix",
    "lint-staged": "lint-staged",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "docker compose run --rm --build test",
    "test:e2e:local": "playwright test",
    "test:e2e:netlify-smoke": "playwright test e2e/netlify-smoke.spec.ts --project=chromium",
    "test:lighthouse": "rm -rf lighthouse-report .lighthouseci && lhci autorun; open $(node -e \"const m=require('./lighthouse-report/manifest.json');console.log(m.find(r=>r.isRepresentativeRun).htmlPath)\")"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.0.5",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.9",
    "browserslist": "^4.28.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.70.0",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.69.0",
    "playwright": "^1.58.2",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "overrides": {
    "cookie": "^0.7.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.2.5",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.6",
    "@tabler/icons-svelte-runes": "^3.41.1",
    "bezier-easing": "^3.0.0",
    "color-name-list": "^14.36.0",
    "colorjs.io": "^0.6.1",
    "dfoptim": "^0.0.6",
    "dompurify": "^3.4.0",
    "mutative": "^1.3.0",
    "travels": "^1.1.0"
  }
}
